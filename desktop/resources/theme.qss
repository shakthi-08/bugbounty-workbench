QWidget {
    color: #e6edf7;
    font-family: "Segoe UI";
    font-size: 10pt;
}

#appRoot, #contentArea {
    background: #10151d;
}

#sidebar {
    background: #151c26;
    border-right: 1px solid #283343;
}

#brand {
    color: #f4f7fb;
    font-size: 16pt;
    font-weight: 700;
    letter-spacing: 1px;
}

#sidebarCaption {
    color: #8593a8;
    font-size: 8pt;
    letter-spacing: 1px;
}

QPushButton#navButton {
    color: #aeb9c9;
    background: transparent;
    border: 0;
    border-radius: 7px;
    padding: 11px 13px;
    text-align: left;
}

QPushButton#navButton:hover {
    color: #f7faff;
    background: #202b39;
}

QPushButton#navButton:checked {
    color: #f5fbff;
    background: #153950;
    border-left: 3px solid #33c8a0;
    font-weight: 600;
}

#topbar {
    background: #131a23;
    border-bottom: 1px solid #283343;
}

#viewTitle {
    color: #f5f7fb;
    font-size: 21pt;
    font-weight: 650;
}

#viewSubtitle, #metricCaption {
    color: #98a6b9;
}

#currentProject, #cardTitle {
    color: #e7eef9;
    font-size: 13pt;
    font-weight: 600;
}

#backendStatus {
    color: #ffcc78;
    font-weight: 600;
}

#backendStatus[connected="true"] {
    color: #7de0bd;
}

#metricCard, #detailCard, #placeholderCard {
    background: #171f2a;
    border: 1px solid #2b3849;
    border-radius: 10px;
}

#metricValue {
    color: #41d5b0;
    font-size: 25pt;
    font-weight: 700;
}

#metricCaption {
    font-size: 9pt;
}

#statusPill {
    color: #ffcc78;
    background: #382f20;
    border-radius: 12px;
    padding: 6px 11px;
    font-size: 9pt;
    font-weight: 600;
}

#statusPill[connected="true"] {
    color: #7de0bd;
    background: #173a32;
}

QPushButton#primaryButton, QPushButton#secondaryButton {
    border-radius: 7px;
    padding: 9px 15px;
    font-weight: 600;
}

QPushButton#primaryButton {
    color: #081a17;
    background: #39cba4;
    border: 1px solid #39cba4;
}

QPushButton#primaryButton:hover {
    background: #56dfb9;
}

QPushButton#secondaryButton {
    color: #d6e0ed;
    background: #202a37;
    border: 1px solid #344356;
}

QPushButton#secondaryButton:hover {
    background: #293749;
}

QPushButton#disabledAction {
    color: #8792a2;
    background: #252c36;
    border: 1px solid #394454;
    border-radius: 7px;
    padding: 9px;
}

#errorBanner {
    color: #ffceba;
    background: #422722;
    border-bottom: 1px solid #764036;
    padding: 10px 18px;
}

#infoBanner {
    color: #b7cbe0;
    background: #1c2d3b;
    border: 1px solid #2f4c62;
    border-radius: 7px;
    padding: 10px;
}

#emptyState {
    color: #8593a8;
    background: #151c26;
    border: 1px dashed #3a4759;
    border-radius: 9px;
    padding: 28px;
}

#dataTable {
    background: #151c26;
    alternate-background-color: #19222e;
    border: 1px solid #2b3849;
    gridline-color: #293647;
    selection-background-color: #174a50;
}

QHeaderView::section {
    color: #aebbd0;
    background: #1b2532;
    border: 0;
    border-bottom: 1px solid #354356;
    padding: 9px;
    font-weight: 600;
}

QComboBox {
    color: #e6edf7;
    background: #171f2a;
    border: 1px solid #364356;
    border-radius: 6px;
    padding: 7px 10px;
}

QComboBox QAbstractItemView {
    color: #e6edf7;
    background: #171f2a;
    selection-background-color: #174a50;
}

QCheckBox {
    color: #aebbd0;
    spacing: 8px;
}
